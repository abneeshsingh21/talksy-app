<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            
            <!-- Gradient background circle -->
            <group android:name="bg_group">
                <path
                    android:name="bg_circle"
                    android:pathData="M54,54m-42,0a42,42 0,1 1,84 0a42,42 0,1 1,-84 0">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="radial"
                            android:centerX="54"
                            android:centerY="54"
                            android:gradientRadius="42">
                            <item android:offset="0" android:color="#FF00D9FF"/>
                            <item android:offset="0.5" android:color="#FF0099CC"/>
                            <item android:offset="1" android:color="#FF006699"/>
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
            
            <!-- Outer glow ring -->
            <group android:name="glow_ring">
                <path
                    android:name="glow"
                    android:pathData="M54,54m-38,0a38,38 0,1 1,76 0a38,38 0,1 1,-76 0"
                    android:strokeColor="#80FFFFFF"
                    android:strokeWidth="1.5"
                    android:fillColor="#00000000"/>
            </group>
            
            <!-- Main chat bubble -->
            <group android:name="bubble_group"
                android:pivotX="54"
                android:pivotY="50">
                <path
                    android:name="chat_bubble"
                    android:fillColor="#FFFFFF"
                    android:pathData="M54,32c-12,0 -22,8 -22,18c0,5 2.5,9.5 6.5,12.7L36,72l9.5,-4.75c2.7,0.85 5.6,1.3 8.5,1.3c12,0 22,-8 22,-18S66,32 54,32z"/>
            </group>
            
            <!-- Animated dot 1 -->
            <group android:name="dot1_group"
                android:pivotX="45"
                android:pivotY="48">
                <path
                    android:name="dot1"
                    android:fillColor="#00D9FF"
                    android:pathData="M45,48m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0"/>
            </group>
            
            <!-- Animated dot 2 -->
            <group android:name="dot2_group"
                android:pivotX="54"
                android:pivotY="48">
                <path
                    android:name="dot2"
                    android:fillColor="#00FF88"
                    android:pathData="M54,48m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0"/>
            </group>
            
            <!-- Animated dot 3 -->
            <group android:name="dot3_group"
                android:pivotX="63"
                android:pivotY="48">
                <path
                    android:name="dot3"
                    android:fillColor="#FFD700"
                    android:pathData="M63,48m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0"/>
            </group>
        </vector>
    </aapt:attr>
    
    <!-- Dot 1 pulse animation -->
    <target android:name="dot1_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="600"
                    android:valueFrom="1"
                    android:valueTo="1.3"
                    android:valueType="floatType"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="600"
                    android:valueFrom="1"
                    android:valueTo="1.3"
                    android:valueType="floatType"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"/>
            </set>
        </aapt:attr>
    </target>
    
    <!-- Dot 2 pulse animation (delayed) -->
    <target android:name="dot2_group">
        <aapt:attr name="android:animation">
            <set android:startOffset="200">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="600"
                    android:valueFrom="1"
                    android:valueTo="1.3"
                    android:valueType="floatType"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="600"
                    android:valueFrom="1"
                    android:valueTo="1.3"
                    android:valueType="floatType"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"/>
            </set>
        </aapt:attr>
    </target>
    
    <!-- Dot 3 pulse animation (more delayed) -->
    <target android:name="dot3_group">
        <aapt:attr name="android:animation">
            <set android:startOffset="400">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="600"
                    android:valueFrom="1"
                    android:valueTo="1.3"
                    android:valueType="floatType"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="600"
                    android:valueFrom="1"
                    android:valueTo="1.3"
                    android:valueType="floatType"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"/>
            </set>
        </aapt:attr>
    </target>
    
    <!-- Bubble subtle pulse -->
    <target android:name="bubble_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="2000"
                    android:valueFrom="1"
                    android:valueTo="1.02"
                    android:valueType="floatType"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="2000"
                    android:valueFrom="1"
                    android:valueTo="1.02"
                    android:valueType="floatType"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
